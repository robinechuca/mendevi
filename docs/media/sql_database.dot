# dot -Tpdf sql_database.dot -o /tmp/sql_database.pdf && pdfcrop /tmp/sql_database.pdf sql_database.pdf
# dot -Tsvg sql_database.dot > sql_database.svg
graph database {
  node [shape=plaintext]
  t_act_activity [
    label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
        <TR><TD COLSPAN="2" BGCOLOR="#ef597b"><B>t_act_activity</B></TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#ffcb18">act_id</TD><TD ALIGN="LEFT"><FONT COLOR="#29a2c6">INTEGER</FONT></TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">act_start</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">act_duration</TD><TD ALIGN="LEFT">FLOAT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">act_rapl_dt</TD><TD ALIGN="LEFT">LONGBLOB</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">act_rapl_power</TD><TD ALIGN="LEFT">LONGBLOB</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">act_wattmeter_dt</TD><TD ALIGN="LEFT">LONGBLOB</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">act_wattmeter_power</TD><TD ALIGN="LEFT">LONGBLOB</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">act_gpu_dt</TD><TD ALIGN="LEFT">LONGBLOB</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">act_gpu_core</TD><TD ALIGN="LEFT">LONGBLOB</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">act_gpu_memory</TD><TD ALIGN="LEFT">LONGBLOB</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">act_gpu_power</TD><TD ALIGN="LEFT">LONGBLOB</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">act_ps_dt</TD><TD ALIGN="LEFT">LONGBLOB</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">act_ps_core</TD><TD ALIGN="LEFT">LONGBLOB</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">act_ps_temp</TD><TD ALIGN="LEFT">JSON</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">act_ps_ram</TD><TD ALIGN="LEFT">LONGBLOB</TD></TR>
      </TABLE>
    >
  ];
  t_vid_video [
    label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
        <TR><TD COLSPAN="2" BGCOLOR="#ef597b"><B>t_vid_video</B></TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#ffcb18">vid_id</TD><TD ALIGN="LEFT"><FONT COLOR="#29a2c6">BINARY(128)</FONT></TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">vid_name</TD><TD ALIGN="LEFT">TEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">vid_codec</TD><TD ALIGN="LEFT">TINYTEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">vid_duration</TD><TD ALIGN="LEFT">FLOAT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">vid_eotf</TD><TD ALIGN="LEFT">TINYTEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">vid_fps</TD><TD ALIGN="LEFT">FLOAT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">vid_frames</TD><TD ALIGN="LEFT">JSON</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">vid_gamut</TD><TD ALIGN="LEFT">TINYTEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">vid_height</TD><TD ALIGN="LEFT">SMALLINT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">vid_pix_fmt</TD><TD ALIGN="LEFT">TINYTEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">vid_range</TD><TD ALIGN="LEFT">TINYTEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">vid_size</TD><TD ALIGN="LEFT">BIGINT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">vid_width</TD><TD ALIGN="LEFT">SMALLINT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">vid_rms_sobel</TD><TD ALIGN="LEFT">LONGBLOB</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">vid_rms_time_diff</TD><TD ALIGN="LEFT">LONGBLOB</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">vid_spatial_dct</TD><TD ALIGN="LEFT">LONGBLOB</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">vid_temporal_dct</TD><TD ALIGN="LEFT">LONGBLOB</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">vid_uvq</TD><TD ALIGN="LEFT">LONGBLOB</TD></TR>
      </TABLE>
    >
  ];
  t_met_metric [
    label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
        <TR><TD COLSPAN="2" BGCOLOR="#ef597b"><B>t_met_metric</B></TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#ffcb18">met_id</TD><TD ALIGN="LEFT"><FONT COLOR="#29a2c6">INTEGER</FONT></TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">met_ref_vid_id</TD><TD ALIGN="LEFT">BINARY(128)</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">met_dis_vid_id</TD><TD ALIGN="LEFT">BINARY(128)</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">met_lpips_alex</TD><TD ALIGN="LEFT">LONGBLOB</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">met_lpips_vgg</TD><TD ALIGN="LEFT">LONGBLOB</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">met_psnr</TD><TD ALIGN="LEFT">LONGBLOB</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">met_ssim</TD><TD ALIGN="LEFT">LONGBLOB</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">met_vif</TD><TD ALIGN="LEFT">LONGBLOB</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">met_vmaf</TD><TD ALIGN="LEFT">LONGBLOB</TD></TR>
      </TABLE>
    >
  ];
  t_env_environment [
    label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
        <TR><TD COLSPAN="2" BGCOLOR="#ef597b"><B>t_env_environment</B></TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#ffcb18">env_id</TD><TD ALIGN="LEFT"><FONT COLOR="#29a2c6">INTEGER</FONT></TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">env_ffmpeg_version</TD><TD ALIGN="LEFT">MEDIUMTEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">env_hostname</TD><TD ALIGN="LEFT">TINYTEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">env_kernel_version</TD><TD ALIGN="LEFT">TINYTEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">env_librav1e_version</TD><TD ALIGN="LEFT">MEDIUMTEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">env_libsvtav1_version</TD><TD ALIGN="LEFT">MEDIUMTEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">env_libvpx_vp9_version</TD><TD ALIGN="LEFT">MEDIUMTEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">env_libvvenc_version</TD><TD ALIGN="LEFT">MEDIUMTEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">env_libx265_version</TD><TD ALIGN="LEFT">MEDIUMTEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">env_logical_cores</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">env_lshw</TD><TD ALIGN="LEFT">JSON</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">env_lspci</TD><TD ALIGN="LEFT">JSON</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">env_physical_cores</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">env_pip_freeze</TD><TD ALIGN="LEFT">MEDIUMTEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">env_processor</TD><TD ALIGN="LEFT">TINYTEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">env_python_compiler</TD><TD ALIGN="LEFT">TINYTEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">env_python_version</TD><TD ALIGN="LEFT">TINYTEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">env_ram</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">env_swap</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">env_system_version</TD><TD ALIGN="LEFT">MEDIUMTEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">env_idle_act_id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
      </TABLE>
    >
  ];
  t_dec_decode [
    label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
        <TR><TD COLSPAN="2" BGCOLOR="#ef597b"><B>t_dec_decode</B></TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#ffcb18">dec_id</TD><TD ALIGN="LEFT"><FONT COLOR="#29a2c6">INTEGER</FONT></TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">dec_vid_id</TD><TD ALIGN="LEFT">BINARY(128)</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">dec_env_id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">dec_act_id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">dec_cmd</TD><TD ALIGN="LEFT">TEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">dec_decoder</TD><TD ALIGN="LEFT">TINYTEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">dec_filter</TD><TD ALIGN="LEFT">TEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">dec_height</TD><TD ALIGN="LEFT">SMALLINT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">dec_log</TD><TD ALIGN="LEFT">LONGTEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">dec_pix_fmt</TD><TD ALIGN="LEFT">TINYTEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">dec_width</TD><TD ALIGN="LEFT">SMALLINT</TD></TR>
      </TABLE>
    >
  ];
  t_enc_encode [
    label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
        <TR><TD COLSPAN="2" BGCOLOR="#ef597b"><B>t_enc_encode</B></TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#ffcb18">enc_id</TD><TD ALIGN="LEFT"><FONT COLOR="#29a2c6">INTEGER</FONT></TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">enc_src_vid_id</TD><TD ALIGN="LEFT">BINARY(128)</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">enc_dst_vid_id</TD><TD ALIGN="LEFT">BINARY(128)</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">enc_env_id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">enc_act_id</TD><TD ALIGN="LEFT">INTEGER</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">enc_cmd</TD><TD ALIGN="LEFT">TEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">enc_effort</TD><TD ALIGN="LEFT">TINYTEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">enc_encoder</TD><TD ALIGN="LEFT">TINYTEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">enc_filter</TD><TD ALIGN="LEFT">TEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">enc_fps</TD><TD ALIGN="LEFT">FLOAT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">enc_height</TD><TD ALIGN="LEFT">SMALLINT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">enc_log</TD><TD ALIGN="LEFT">LONGTEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">enc_mode</TD><TD ALIGN="LEFT">TINYTEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">enc_pix_fmt</TD><TD ALIGN="LEFT">TINYTEXT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">enc_quality</TD><TD ALIGN="LEFT">FLOAT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">enc_threads</TD><TD ALIGN="LEFT">SMALLINT</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#29a2c6">enc_width</TD><TD ALIGN="LEFT">SMALLINT</TD></TR>
      </TABLE>
    >
  ];
  t_enc_encode -- t_act_activity [minlen=3 taillabel="1" headlabel="1" xlabel="encoding\nressources" labeldistance=2.0]
  t_enc_encode -- t_env_environment [minlen=3 taillabel="1" headlabel="*" xlabel="machine\ncontext" labeldistance=2.0]
  t_enc_encode -- t_vid_video [minlen=3 taillabel="1" headlabel="*" xlabel="output\nvideo" labeldistance=2.0]
  t_met_metric -- t_vid_video [minlen=3 taillabel="1" headlabel="*" xlabel="video\nquality" labeldistance=2.0]
  t_dec_decode -- t_act_activity [minlen=3 taillabel="1" headlabel="1" xlabel="decoding\nresources" labeldistance=2.0]
  t_dec_decode -- t_env_environment [minlen=3 taillabel="1" headlabel="*" xlabel="machine\ncontext" labeldistance=2.0]
  t_dec_decode -- t_vid_video [minlen=3 taillabel="1" headlabel="*" xlabel="input\nvideo" labeldistance=2.0]
  t_env_environment -- t_act_activity [minlen=3 taillabel="1" headlabel="1" xlabel="idle\nresources" labeldistance=2.0]
}
