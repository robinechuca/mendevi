# dot -Tpdf intrinsic.dot -o /tmp/intrinsic.pdf && pdfcrop /tmp/intrinsic.pdf intrinsic.pdf
# dot -Tsvg intrinsic.dot > intrinsic.svg
digraph intrinsic {
    rankdir=LR
    node [fontname="DejaVu Sans"]  // for symbol ≠
    edge [fontname="DejaVu Sans"]

    # data
    full [label="{Xᵢ}" shape=Mdiamond style=filled fillcolor="#73b66b"]
    ref [label="Y" shape=Mdiamond style=filled fillcolor="#73b66b"]
    var  [label="Xₖ" shape=Mdiamond style=filled fillcolor="#73b66b"]
    norm [label="Ỹ" shape=Mdiamond style=filled fillcolor="#73b66b"]
    est  [label="Ŷ" shape=Mdiamond style=filled fillcolor="#73b66b"]
    comp [label="{Xᵢ}, i≠k" shape=Mdiamond style=filled fillcolor="#73b66b"]

    # process
    truth [label="φ" style=filled fillcolor=white]
    interest [label="φ̃ " style=filled fillcolor="#ef597b"]
    adapt [label="ψ" style=filled fillcolor="#ef597b"]
    denorm [label="a Ỹ + b" style=filled fillcolor=white]

    # blocs
    subgraph clus_reference {
        cluster=true
        label="Reference"
        bgcolor="#29a2c6"
        full truth ref
    }

    subgraph clus_imitation {
        cluster=true
        label="Imitation"
        bgcolor="#29a2c6"
        var interest norm denorm est comp adapt

        subgraph clus_interest {
            cluster=true
            label="Trend catcher"
            bgcolor="#ffcb18"
            var interest norm
        }

        subgraph clus_denorm {
            cluster=true
            label="Denormalizator"
            bgcolor="#ffcb18"
            denorm
        }
    }

    # pipeline
    full -> truth -> ref
    var -> interest -> norm -> denorm -> est
    comp -> adapt
    adapt -> denorm [label="a,b"]
}
