# dot -Tsvg pipeline.dot > pipeline.svg
digraph pipeline {
    rankdir=LR

    # data
    src [label="Input\nvideo file", shape=Mdiamond, style=filled, fillcolor=white]
    ref [label="Reference\nvideo file", shape=Mdiamond, style=filled, fillcolor=white]
    dst [label="Encoded\nvideo file", shape=Mdiamond, style=filled, fillcolor=white]

    # parameters
    p_colorspace [label="Colorspace", shape=note, style=filled, fillcolor=white]
    p_fps [label="fps", shape=note, style=filled, fillcolor=white]
    p_pxl [label="Pxl Format", shape=note, style=filled, fillcolor=white]
    p_resol [label="Resolution", shape=note, style=filled, fillcolor=white]

    c_fps [label="fps", shape=note, style=filled, fillcolor=white]
    c_pxl [label="Pxl Format", shape=note, style=filled, fillcolor=white]
    c_resol [label="Resolution", shape=note, style=filled, fillcolor=white]

    effort [label="Effort", shape=note, style=filled, fillcolor=white]
    encoder [label="Encoder", shape=note, style=filled, fillcolor=white]
    quality [label="Quality", shape=note, style=filled, fillcolor=white]
    threads [label="Threads", shape=note, style=filled, fillcolor=white]

    database [label="Database", shape=folder, style=filled, fillcolor=white]

    # process
    prepare [label="Transcode", style=filled, fillcolor=white]
    t_dec [label="Decode", style=filled, fillcolor=white]
    t_convert [label="Convert", style=filled, fillcolor=white]
    t_encode [label="Encode", style=filled, fillcolor=white]
    decode [label="Decode", style=filled, fillcolor=white]
    convert [label="Convert", style=filled, fillcolor=white]
    probe [label="Probe", style=filled, fillcolor=white]
    idle [label="IDLE", style=filled, fillcolor=white]

    # blocs
    subgraph clus_prepare {
        cluster=true
        label="step: Preparation"
        bgcolor="#e0ffff"
        prepare
    }
    subgraph clus_energy {
        cluster=true
        label="Measure activity"
        bgcolor="#ffffe0"
        subgraph clus_encode {
            cluster=true
            label="step: Encode"
            bgcolor="#e0ffff"
            t_dec
            t_convert
            t_encode
        }
        subgraph clus_decode {
            cluster=true
            label="step: Decode"
            bgcolor="#e0ffff"
            decode
            convert
        }
        idle
    }
    subgraph clus_probe {
        cluster=true
        label="step: Probe"
        bgcolor="#e0ffff"
        probe
    }

    # parameters blocs
    subgraph clus_param_prepare {
        cluster=true
        label="Parameters"
        bgcolor="#ffe0ff"
        p_colorspace
        p_fps
        p_pxl
        p_resol
    }
    subgraph clus_param_convert {
        cluster=true
        label="Parameters"
        bgcolor="#ffe0ff"
        c_fps
        c_pxl
        c_resol
    }
    subgraph clus_param_encode {
        cluster=true
        label="Parameters"
        bgcolor="#ffe0ff"
        effort
        encoder
        quality
        threads
    }

    # pipeline
    src -> prepare -> ref -> t_dec -> t_convert -> t_encode -> dst -> {decode, probe}
    decode -> convert
    {idle, t_encode, convert, probe} -> database [style=dotted] # minlen=2

    # arguments
    {p_colorspace, p_fps, p_pxl, p_resol} -> prepare [arrowhead=none, style=dashed]
    {c_fps, c_pxl, c_resol} -> t_convert [arrowhead=none, style=dashed]
    {effort, encoder, quality, threads} -> t_encode [arrowhead=none, style=dashed]
    {c_resol} -> convert [arrowhead=none, style=dashed]
}